# API Go Pharma Pro (Vercel)
EXPO_PUBLIC_API_URL=https://gopharmapro.com/api/v1
EXPO_PUBLIC_SITE_URL=https://gopharmapro.com

# Google OAuth — client type « Application Web » (pas Android)
# Console : https://console.cloud.google.com/apis/credentials
#
# Origines JavaScript autorisées (sans slash final, sans chemin) :
#   http://localhost:3000
#   http://localhost:3001
#   https://gopharmapro.com
#   https://www.gopharmapro.com
#   https://gopharmapro-hql0rihgj-ndom2504s-projects.vercel.app
#
# URI de redirection autorisées :
#   http://localhost:3000
#   http://localhost:3001
#   https://gopharmapro.com
#   https://www.gopharmapro.com
#   https://gopharmapro-hql0rihgj-ndom2504s-projects.vercel.app
#   https://auth.expo.io/@ndom2504/pharmarket-mobile
#     (Expo Go ouvre …/start?returnUrl=exp://… — ne pas retirer cette URI)
#
# Android (autre client) : package ga.pharmamarket.app
# SHA-1 debug : 64:C2:FC:BC:CD:88:88:65:F6:EF:F2:6C:5A:37:FE:00:3D:82:95:CC
# Client ID Web = xxxxx.apps.googleusercontent.com  (PAS le secret GOCSPX-…)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=1063129391016-u1g48s64uc0sjctrk4h1ijd43ims24jh.apps.googleusercontent.com

# Stripe — secret uniquement sur Vercel (web), pas dans l’app
# STRIPE_SECRET_KEY=sk_test_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Console interne (web) — Vercel + racine .env (chargé par web/next.config.ts)
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
