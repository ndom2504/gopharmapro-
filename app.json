{
  "expo": {
    "name": "Go Pharma Pro",
    "slug": "pharmarket-mobile",
    "owner": "ndom2504",
    "scheme": "pharmarket",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain"
        }
      ],
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Go Pharma Pro utilise votre position pour afficher les pharmacies les plus proches et estimer la livraison au Gabon."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Go Pharma Pro utilise vos photos pour illustrer les produits et transmettre une ordonnance.",
          "cameraPermission": "Go Pharma Pro utilise l’appareil photo pour photographier les produits et les ordonnances."
        }
      ],
      "expo-document-picker",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#00B428",
          "sounds": [
            "./assets/sounds/payment.wav",
            "./assets/sounds/payout.wav",
            "./assets/sounds/catalog.wav"
          ]
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ],
    "ios": {
      "bundleIdentifier": "ga.pharmamarket.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Go Pharma Pro utilise votre position pour afficher les pharmacies les plus proches et estimer la livraison au Gabon.",
        "NSPhotoLibraryUsageDescription": "Go Pharma Pro utilise vos photos pour illustrer les produits et transmettre une ordonnance.",
        "NSCameraUsageDescription": "Go Pharma Pro utilise l’appareil photo pour photographier les produits et les ordonnances."
      }
    },
    "androidNavigationBar": {
      "backgroundColor": "#FFFFFF",
      "barStyle": "dark-content"
    },
    "android": {
      "package": "ga.pharmamarket.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS"
      ]
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "googleWebClientId": "1063129391016-g4fcpv8rkm5bvpimhh2mhbbn3gg4sr0q.apps.googleusercontent.com",
      "googleIosClientId": "1063129391016-ames824nj5ioqreoorne759egusmhidm.apps.googleusercontent.com",
      "googleAndroidClientId": "1063129391016-u1g48s64uc0sjctrk4h1ijd43ims24jh.apps.googleusercontent.com"
    }
  }
}
