NEXT_PUBLIC_SITE_URL=https://gopharmapro.com
NEXT_PUBLIC_APP_NAME=Gopharmapro

# Client Google type « Application Web »
# Origines JS : http://localhost:3000 | http://localhost:3001 | https://gopharmapro.com | https://www.gopharmapro.com
# + preview Vercel actuelle : https://gopharmapro-hql0rihgj-ndom2504s-projects.vercel.app
# En local, le Client ID Web du .env racine (EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID) est aussi chargé.
NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Neon (Vercel Integration → Postgres)
# postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
DATABASE_URL=

# Stripe (clés test : https://dashboard.stripe.com/test/apikeys)
# Secret uniquement côté serveur Vercel — jamais dans l’app Expo
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Webhook Identity : identity.verification_session.verified
# Endpoint : https://VOTRE-DOMAINE/api/v1/identity/webhook
STRIPE_WEBHOOK_SECRET=

# GeniusPay — Bénin (https://geniuspay.ci/docs/api)
# Webhook : https://VOTRE-DOMAINE/api/v1/payments/geniuspay/webhook
GENIUSPAY_API_KEY=
GENIUSPAY_API_SECRET=
GENIUSPAY_WEBHOOK_SECRET=

# Console interne — définir aussi dans Vercel. Ne jamais committer les vraies valeurs.
ADMIN_EMAIL=
ADMIN_PASSWORD=
