generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductCountryStatus {
  PENDING
  PENDING_REVIEW
  ACTIVE
  RESTRICTED
  INACTIVE
  UNKNOWN
}

model Country {
  id               String           @id @default(cuid())
  code             String           @unique
  name             String
  currency         String
  currencySymbol   String
  active           Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  categories       Category[]
  pharmacies       Pharmacy[]
  productCountries ProductCountry[]
  customers        CustomerProfile[]

  @@index([code])
}

model Category {
  id          String    @id @default(cuid())
  countryId   String
  country     Country   @relation(fields: [countryId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  description String?
  active      Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@unique([countryId, slug])
  @@index([countryId])
  @@index([slug])
}

model Product {
  id                   String            @id @default(cuid())
  categoryId           String
  category             Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  name                 String
  slug                 String            @unique
  genericName          String?
  brandName            String?
  activeIngredient     String?
  dosage               String?
  dosageUnit           String?
  pharmaceuticalForm   String?
  packaging            String?
  description          String?
  requiresPrescription Boolean           @default(false)
  imageUrl             String?
  imageAlt             String?
  active               Boolean           @default(true)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  countryStatuses      ProductCountry[]
  pharmacyOffers       PharmacyProduct[]
  prescriptionRequests PrescriptionRequest[]
  orderItems           OrderItem[]

  @@index([slug])
  @@index([name])
  @@index([genericName])
  @@index([activeIngredient])
  @@index([brandName])
  @@index([active])
  @@index([categoryId])
}

model ProductCountry {
  id                   String                @id @default(cuid())
  productId            String
  product              Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  countryId            String
  country              Country               @relation(fields: [countryId], references: [id], onDelete: Cascade)
  status               ProductCountryStatus  @default(PENDING_REVIEW)
  requiresPrescription Boolean?
  regulatoryReference  String?
  regulatoryNote       String?
  verified             Boolean               @default(false)
  verifiedAt           DateTime?
  active               Boolean               @default(true)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@unique([productId, countryId])
  @@index([countryId])
  @@index([status])
  @@index([productId])
}

model Pharmacy {
  id        String            @id @default(cuid())
  accountId String?           @unique
  name      String
  legalName String?
  email     String
  phone     String?
  address   String?
  city      String?
  countryId String
  country   Country           @relation(fields: [countryId], references: [id], onDelete: Restrict)
  latitude  Float?
  longitude Float?
  active    Boolean           @default(true)
  verified  Boolean           @default(false)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  offers               PharmacyProduct[]
  prescriptionRequests PrescriptionRequest[]
  orders               Order[]

  @@index([countryId])
  @@index([city])
  @@index([latitude, longitude])
  @@index([email])
}

model PharmacyProduct {
  id                String    @id @default(cuid())
  pharmacyId        String
  pharmacy          Pharmacy  @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  productId         String
  product           Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  price             Decimal   @db.Decimal(12, 2)
  currency          String
  stockQuantity     Int
  available         Boolean   @default(true)
  deliveryAvailable Boolean   @default(false)
  pickupAvailable   Boolean   @default(true)
  internalReference String?
  lastStockUpdate   DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  cartItems         CartItem[]
  orderItems        OrderItem[]

  @@unique([pharmacyId, productId])
  @@index([productId])
  @@index([pharmacyId])
  @@index([available])
}

enum PrescriptionStatus {
  PENDING_PRESCRIPTION
  PRESCRIPTION_SUBMITTED
  PRESCRIPTION_APPROVED
  PRESCRIPTION_REJECTED
}

model CustomerProfile {
  id                   String                @id @default(cuid())
  accountId            String                @unique
  countryId            String
  country              Country               @relation(fields: [countryId], references: [id], onDelete: Restrict)
  city                 String?
  address              String?
  latitude             Float?
  longitude            Float?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  prescriptionRequests PrescriptionRequest[]
  cart                 Cart?
  orders               Order[]

  @@index([countryId])
  @@index([city])
}

enum OrderStatus {
  CART
  PENDING_PRESCRIPTION
  PRESCRIPTION_REVIEW
  READY_FOR_PAYMENT
  PAYMENT_PENDING
  PAID
  PREPARING
  READY_FOR_PICKUP
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REJECTED
}

enum FulfillmentMethod {
  PICKUP
  DELIVERY
}

enum OrderPrescriptionStatus {
  NOT_REQUIRED
  PENDING
  SUBMITTED
  APPROVED
  REJECTED
}

model Cart {
  id         String     @id @default(cuid())
  customerId String     @unique
  customer   CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items      CartItem[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model CartItem {
  id                String          @id @default(cuid())
  cartId            String
  cart              Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  pharmacyProductId String
  pharmacyProduct   PharmacyProduct @relation(fields: [pharmacyProductId], references: [id], onDelete: Restrict)
  quantity          Int
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([cartId, pharmacyProductId])
  @@index([cartId])
  @@index([pharmacyProductId])
}

model Order {
  id                String            @id @default(cuid())
  orderNumber       String            @unique
  customerId        String
  customer          CustomerProfile   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  pharmacyId        String
  pharmacy          Pharmacy          @relation(fields: [pharmacyId], references: [id], onDelete: Restrict)
  status            OrderStatus
  fulfillmentMethod FulfillmentMethod
  subtotal          Decimal           @db.Decimal(12, 2)
  deliveryFee       Decimal           @db.Decimal(12, 2)
  total             Decimal           @db.Decimal(12, 2)
  currency          String
  deliveryAddress   String?
  deliveryCity      String?
  deliveryLatitude  Float?
  deliveryLongitude Float?
  deliveryPhone     String?
  notes             String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  items             OrderItem[]
  prescription      OrderPrescription?

  @@index([customerId])
  @@index([pharmacyId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id                   String           @id @default(cuid())
  orderId              String
  order                Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId            String
  product              Product          @relation(fields: [productId], references: [id], onDelete: Restrict)
  pharmacyProductId    String?
  pharmacyProduct      PharmacyProduct? @relation(fields: [pharmacyProductId], references: [id], onDelete: SetNull)
  productName          String
  productGenericName   String?
  dosage               String?
  pharmaceuticalForm   String?
  quantity             Int
  unitPrice            Decimal          @db.Decimal(12, 2)
  totalPrice           Decimal          @db.Decimal(12, 2)
  prescriptionRequired Boolean          @default(false)
  createdAt            DateTime         @default(now())

  @@index([orderId])
  @@index([productId])
}

model OrderPrescription {
  id          String                  @id @default(cuid())
  orderId     String                  @unique
  order       Order                   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  documentUrl String?
  status      OrderPrescriptionStatus @default(PENDING)
  note        String?
  reviewedBy  String?
  reviewedAt  DateTime?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
}

model PrescriptionRequest {
  id           String             @id @default(cuid())
  customerId   String
  customer     CustomerProfile    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  pharmacyId   String
  pharmacy     Pharmacy           @relation(fields: [pharmacyId], references: [id], onDelete: Restrict)
  productId    String
  product      Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity     Int                @default(1)
  documentUrl  String?
  status       PrescriptionStatus @default(PENDING_PRESCRIPTION)
  note         String?
  reviewedAt   DateTime?
  reviewedBy   String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([customerId])
  @@index([pharmacyId])
  @@index([productId])
  @@index([status])
}
